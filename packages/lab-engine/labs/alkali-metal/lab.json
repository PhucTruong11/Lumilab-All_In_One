{
  "schema_version": "1.0",
  "id": "alkali-metal",
  "title": "Kim loại kiềm tác dụng với nước & Thử màu ngọn lửa",
  "subject": "chemistry",
  "model_version": "alkali-metal-water-flame-v1",
  "dataset_version": "client-expansion-draft-2026-11-01",
  "implementation_status": "client",
  "review_status": "draft",
  "assumptions": [
    "Phản ứng mãnh liệt giữa kim loại kiềm nhóm IA với nước: 2M + 2H2O -> 2MOH + H2.",
    "Khí H2 đo ở điều kiện chuẩn 25°C, 1 bar (24,79 L/mol). Hiện tượng và màu ngọn lửa theo SGK Hóa học 12."
  ],
  "sources": [
    {
      "label": "Nguyên tố nhóm IA · SGK Hóa học 12 & OpenStax Chemistry 2e §18.1",
      "url": "https://openstax.org/books/chemistry-2e/pages/18-1-periodicity"
    }
  ],
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "metal",
      "mass_g",
      "waterVolume_ml",
      "mode"
    ],
    "properties": {
      "metal": {
        "type": "string",
        "enum": ["na", "k"],
        "description": "Kim loại kiềm: Na hoặc K"
      },
      "mass_g": {
        "type": "number",
        "minimum": 0.05,
        "maximum": 0.5,
        "description": "g"
      },
      "waterVolume_ml": {
        "type": "number",
        "minimum": 50,
        "maximum": 250,
        "description": "mL"
      },
      "mode": {
        "type": "string",
        "enum": ["water_reaction", "flame_test"],
        "description": "Chế độ: phản ứng với nước hoặc thử màu ngọn lửa"
      }
    }
  },
  "defaults": {
    "metal": "na",
    "mass_g": 0.23,
    "waterVolume_ml": 100,
    "mode": "water_reaction"
  }
}
