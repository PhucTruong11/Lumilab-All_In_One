      "stiffness_N_m": {
        "type": "number",
        "minimum": 5,
        "maximum": 100,
        "description": "N/m"
      },
      "displacement_m": {
        "type": "number",
        "minimum": -0.4,
        "maximum": 0.4,
        "description": "m"
      }
    }
  },
  "defaults": {
    "mass_kg": 0.5,
    "stiffness_N_m": 20,
    "displacement_m": 0.2
