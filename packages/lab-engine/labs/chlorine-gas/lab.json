{
  "schema_version": "1.0",
  "id": "chlorine-gas",
  "title": "Điều chế và tính tẩy màu của khí clo",
  "subject": "chemistry",
  "model_version": "chlorine-preparation-bleaching-v1",
  "dataset_version": "client-expansion-draft-2026-11-01",
  "implementation_status": "client",
  "review_status": "draft",
  "assumptions": [
    "Điều chế khí Cl2 từ KMnO4 tác dụng với HCl đặc: 2KMnO4 + 16HCl -> 2KCl + 2MnCl2 + 5Cl2 + 8H2O.",
    "Khí Cl2 khô không có tính tẩy màu; Cl2 ẩm tạo HClO có tính oxi hóa mạnh tẩy màu chất màu."
  ],
  "sources": [
    {
      "label": "Halogen và Clo · SGK Hóa học 10 & OpenStax Chemistry 2e §18.11",
      "url": "https://openstax.org/books/chemistry-2e/pages/18-11-occurrence-preparation-and-properties-of-halogens"
    }
  ],
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "kmno4Mass_g",
      "hclVolume_ml",
      "stripType"
    ],
    "properties": {
      "kmno4Mass_g": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 5,
        "description": "g"
      },
      "hclVolume_ml": {
        "type": "number",
        "minimum": 5,
        "maximum": 50,
        "description": "mL"
      },
      "stripType": {
        "type": "string",
        "enum": ["dry", "wet"],
        "description": "Loại giấy màu thử nghiệm: khô (dry) hoặc ẩm (wet)"
      }
    }
  },
  "defaults": {
    "kmno4Mass_g": 1.58,
    "hclVolume_ml": 20,
    "stripType": "wet"
  }
}
