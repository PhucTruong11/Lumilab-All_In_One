{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lumilab.local/schemas/browser-lab-v1.json",
  "title": "Browser lab config (separate from server catalog)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "subject",
    "model_version",
    "dataset_version",
    "implementation_status",
    "review_status",
    "assumptions",
    "sources",
    "parameter_schema",
    "defaults"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "enum": [
        "pendulum",
        "chemistry",
        "circuit",
        "mechanics",
        "spring",
        "electrochemistry",
        "atomic",
        "parallel-circuit",
        "capacitor",
        "precipitation",
        "gas-reaction",
        "spring-damped",
        "inclined-plane",
        "pulley",
        "alkali-water",
        "copper-nitric",
        "chlorine-bleach"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "subject": {
      "enum": [
        "physics",
        "chemistry"
      ]
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "implementation_status": {
      "const": "client"
    },
    "review_status": {
      "const": "draft"
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 600
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "parameter_schema": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "minProperties": 1
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        }
      }
    },
    "defaults": {
      "type": "object"
    },
    "duration_s": {
      "type": "number",
      "minimum": 1,
      "maximum": 86400
    },
    "constants": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "constant_units": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
