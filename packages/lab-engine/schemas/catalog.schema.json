    },
    "archived": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pendulum",
          "spring",
          "mechanics",
          "circuit",
          "parallel-circuit",
          "capacitor",
          "chemistry",
          "precipitation",
          "gas-reaction",
          "electrochemistry",
          "atomic",
          "spring-damped",
          "inclined-plane",
          "pulley",
          "alkali-water",
          "copper-nitric",
          "chlorine-bleach"
        ]
      },
      "uniqueItems": true
    }
  }
}
