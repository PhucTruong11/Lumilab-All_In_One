{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lumilab.local/schemas/lab-v1.json",
  "title": "LumiLab foundation lab definition", "type": "object", "additionalProperties": false,
  "required": ["id","title","summary","domain","schema_version","model_version","dataset_version","implementation_status","review_status","parameters","evidence_ids"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z][a-z0-9-]{1,63}$"},
    "title": {"type":"string","minLength":1,"maxLength":150},
    "summary": {"type":"string","minLength":1,"maxLength":600},
    "domain": {"enum":["physics","chemistry"]}, "schema_version":{"const":"1.0"},
    "model_version":{"type":"string","minLength":1}, "dataset_version":{"type":"string","minLength":1},
    "implementation_status":{"const":"planned"}, "review_status":{"const":"draft"},
    "evidence_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "parameters":{"type":"object","minProperties":1,"additionalProperties":{"type":"object","additionalProperties":false,"required":["unit","min","max","default"],"properties":{"unit":{"type":"string","minLength":1},"min":{"type":"number"},"max":{"type":"number"},"default":{"type":"number"}}}}
  }
}
