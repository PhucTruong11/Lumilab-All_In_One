# Run from repository root; copy this to the root .env, never commit real values.
LUMILAB_ENV=development
LUMILAB_ALLOWED_ORIGINS=["http://127.0.0.1:5175","http://localhost:5175"]
LUMILAB_KNOWLEDGE_DIR=knowledge
LUMILAB_CONTRACTS_DIR=packages/contracts
# Direct local DB port 15434; inside Docker use host db:5432 instead.
LUMILAB_DATABASE_URL=postgresql+psycopg://lumilab:lumilab_local_only@127.0.0.1:15434/lumilab
LUMILAB_LLM_ENABLED=false
LUMILAB_LLM_EVENT_CAP=0
LUMILAB_RAG_ENABLED=false
# Planned gateway settings; no provider is called by foundation.
LUMILAB_LLM_MODEL=gemini-3.5-flash-lite
LUMILAB_LLM_TIMEOUT_SECONDS=8
LUMILAB_LLM_MAX_OUTPUT_TOKENS=384
LUMILAB_GEMINI_API_KEY=

# Local retrieval works while legacy LLM/RAG enable flags remain false.
# Default: no downloads, no external calls, local keyword-hash vectors in memory.
LUMILAB_RETRIEVAL_EMBEDDER=hash
LUMILAB_RETRIEVAL_STORE=memory
# Optional only after installing extras and obtaining a reviewed local model:
# LUMILAB_RETRIEVAL_EMBEDDER=sentence-transformers
# LUMILAB_RETRIEVAL_MODEL_PATH=./local-models/embedding
# LUMILAB_RETRIEVAL_MODEL_REVISION=reviewed-revision-id
# LUMILAB_RETRIEVAL_STORE=chroma
# LUMILAB_RETRIEVAL_CHROMA_PATH=./.local/chroma

# New build-time hybrid path. Use data_cli build before starting API.
LUMILAB_RAG_ARTIFACT_PATH=.local/retrieval/index.json
# Optional Chroma collection built by data_cli --chroma (not the old Docker HttpServer profile).
# LUMILAB_RAG_CHROMA_PATH=.local/chroma
LUMILAB_RAG_MIN_COSINE=0.82
LUMILAB_RAG_MIN_BM25=0.05
# Set MODEL_FAMILY=e5 for multilingual-e5 candidates (query:/passage: prefixes).
# LUMILAB_RETRIEVAL_MODEL_FAMILY=e5
LUMILAB_LLM_AUDIENCE=under18
LUMILAB_LLM_EVENT_ID=sgu-hackathon-2026
LUMILAB_LLM_DAILY_MICROUSD=0
LUMILAB_LLM_RESERVED_DEMO=5
LUMILAB_LLM_DEMO_MODE=false
LUMILAB_LLM_ALLOW_PROVIDER_FALLBACK=false
LUMILAB_LLM_SESSION_RPM=4
LUMILAB_LLM_SESSION_DAILY=10
# Routes/models/rights/quota flags in knowledge/pipeline/providers.json remain disabled.
# API keys are read server-side from the route's named environment variable only.

# Same-provider model fallback, still requires approved routes/sources and live opt-in.
LUMILAB_LLM_ALLOW_MODEL_FALLBACK=false

# Groq server-side key; do not use VITE_ or commit a real key.
LUMILAB_GROQ_API_KEY=

LUMILAB_LLM_MAX_ATTEMPTS=4
LUMILAB_LLM_TOTAL_TIMEOUT_SECONDS=18

LUMILAB_PROMPT_GUARD_ENABLED=false

LUMILAB_PROMPT_GUARD_MAX_SEGMENTS=4

LUMILAB_PROMPT_GUARD_TIMEOUT_SECONDS=2

LUMILAB_PROMPT_GUARD_THRESHOLD=0.5

LUMILAB_GROQ_SHARED_TPM=8000

LUMILAB_GROQ_SHARED_TPD=200000
